<% content_for :title, "Sign in" %>
<div class="auth-card">
  <div class="auth-brand"><span class="brand-mark" aria-hidden="true">S</span> Salary admin</div>
  <h1>Sign in</h1>
  <p class="muted">Use an administrator account. The HR manager's login does not open this panel.</p>
  <%= form_with url: admin_login_path, method: :post do %>
    <label for="email">Email</label>
    <input id="email" type="email" name="email" autocomplete="username" autofocus required>
    <label for="password">Password</label>
    <input id="password" type="password" name="password" autocomplete="current-password" required>
    <% if @error %><div class="error" role="alert"><%= admin_icon(:alert) %><span><%= @error %></span></div><% end %>
    <button class="button" type="submit">Sign in</button>
  <% end %>
</div>
