<% content_for :title, "Dashboard" %>
<% counts = @metrics.counts %>
<% overview = @metrics.overview %>
<h1>Dashboard</h1>

<div class="kpis">
  <div class="kpi">
    <div class="kpi-label">Employees</div>
    <div class="kpi-value"><%= number_with_delimiter(counts[:employees]) %></div>
    <div class="kpi-note"><%= number_with_delimiter(counts[:active_employees]) %> active &middot; <%= number_with_delimiter(counts[:inactive_employees]) %> inactive <%= link_to "Data", admin_table_path("employees") %></div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Payroll (USD)</div>
    <div class="kpi-value"><%= usd_figure(overview[:payroll_usd]) %></div>
    <div class="kpi-note">Annual, active employees</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Average salary (USD)</div>
    <div class="kpi-value"><%= usd_figure(overview[:average_salary_usd]) %></div>
    <div class="kpi-note">Median <%= usd_figure(overview[:median_salary_usd]) %></div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Departments</div>
    <div class="kpi-value"><%= number_with_delimiter(counts[:departments]) %></div>
    <div class="kpi-note"><%= number_with_delimiter(counts[:job_titles]) %> job titles <%= link_to "Data", admin_table_path("departments") %></div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Countries</div>
    <div class="kpi-value"><%= number_with_delimiter(counts[:countries]) %></div>
    <div class="kpi-note"><%= link_to "Data", admin_table_path("countries") %></div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Salary changes</div>
    <div class="kpi-value"><%= number_with_delimiter(counts[:salary_changes]) %></div>
    <div class="kpi-note">All time <%= link_to "Data", admin_table_path("salary_changes") %></div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Users</div>
    <div class="kpi-value"><%= number_with_delimiter(counts[:users]) %></div>
    <div class="kpi-note"><%= counts[:admins] %> admin &middot; <%= counts[:sessions] %> signed in <%= link_to "Data", admin_table_path("users") %></div>
  </div>
</div>
<% if overview[:rates_as_of] %>
  <p class="muted">USD figures use exchange rates as of <%= overview[:rates_as_of] %>.</p>
<% end %>

<div class="charts">
  <%= bar_chart @metrics.headcount_by_department, title: "Headcount by department" %>
  <%= bar_chart @metrics.headcount_by_country, title: "Headcount by country (top 10)" %>
  <%= column_chart @metrics.hires_by_year, title: "Hires per year" %>
  <%= column_chart @metrics.salary_changes_by_month, title: "Salary changes per month (last 12 months)" %>
  <%= column_chart @metrics.salary_distribution, title: "Salary distribution (USD, active employees)" %>
  <%= donut_chart @metrics.status_split, title: "Active and inactive employees" %>
</div>
