<style>
  :root { --ink: #1f2937; --muted: #6b7280; --line: #e5e7eb; --bg: #f5f6f8; --brand: #1d4ed8; --danger: #b91c1c; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); background: var(--bg); }
  a { color: var(--brand); }
  .topbar { display: flex; align-items: center; gap: 16px; padding: 10px 24px; background: #111827; color: #fff; }
  .topbar a { color: #fff; text-decoration: none; }
  .topbar .brand { font-weight: 700; }
  .topbar .spacer { flex: 1; }
  .topbar .who { color: #9ca3af; font-size: 13px; }
  .topbar form { margin: 0; }
  .link-button { background: none; border: 1px solid #4b5563; color: #fff; border-radius: 6px; padding: 4px 12px; cursor: pointer; font: inherit; font-size: 13px; }
  .page { max-width: 1200px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 22px; margin: 0 0 16px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .muted { color: var(--muted); }
  .auth { max-width: 380px; margin: 10vh auto 0; }
  .auth h1 { margin-bottom: 4px; }
  label { display: block; font-size: 13px; font-weight: 600; margin: 14px 0 4px; }
  input[type=email], input[type=password], input[type=text] { width: 100%; padding: 9px 10px; border: 1px solid #d1d5db; border-radius: 6px; font: inherit; }
  .button { margin-top: 18px; width: 100%; padding: 10px; border: 0; border-radius: 6px; background: var(--brand); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .error { margin-top: 14px; padding: 10px 12px; border-radius: 6px; background: #fef2f2; color: var(--danger); border: 1px solid #fecaca; }
  .topbar nav { display: flex; gap: 16px; }
  .topbar nav a { color: #d1d5db; font-size: 14px; }
  .topbar nav a:hover { color: #fff; }
  h2 { font-size: 16px; margin: 24px 0 8px; }
  .crumbs { margin: 0 0 6px; color: var(--muted); font-size: 13px; }
  .count-note { font-size: 14px; font-weight: 400; }
  .card.flush { padding: 0; overflow: hidden; }
  .card.scroll { overflow-x: auto; }
  .card.empty { text-align: center; color: var(--muted); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; }
  table.data { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  table.data th, table.data td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  table.data thead th { background: #f9fafb; font-size: 12px; text-transform: none; color: var(--muted); position: sticky; top: 0; }
  table.data thead th a { color: inherit; text-decoration: none; }
  table.data tbody tr:hover { background: #f9fafb; }
  table.data .num { text-align: right; font-variant-numeric: tabular-nums; }
  .null { color: #9ca3af; font-style: italic; }
  .search { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; }
  .search input[type=search] { flex: 0 1 380px; padding: 8px 10px; border: 1px solid #d1d5db; border-radius: 6px; font: inherit; }
  .button.inline { margin: 0; width: auto; padding: 8px 16px; }
  .filters { margin: 0 0 14px; padding: 8px 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; font-size: 13.5px; }
  .pager { display: flex; gap: 16px; align-items: center; margin: 14px 0; color: var(--muted); font-size: 13.5px; }
  .pager .spacer { flex: 1; }
  dl.record { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 0; }
  dl.record dt { color: var(--muted); font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px; padding-top: 2px; }
  dl.record dd { margin: 0; word-break: break-word; }
  ul.related { list-style: none; margin: 0; }
  ul.related li { padding: 6px 0; }
  .pill { display: inline-block; min-width: 22px; padding: 0 7px; border-radius: 999px; background: #e0e7ff; color: #3730a3; font-size: 12px; text-align: center; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; margin-bottom: 18px; }
  .kpi { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .kpi-label { color: var(--muted); font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; }
  .kpi-value { font-size: 26px; font-weight: 700; margin: 2px 0; font-variant-numeric: tabular-nums; }
  .kpi-note { color: var(--muted); font-size: 12.5px; }
  .kpi-note a { margin-left: 4px; }
  .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(440px, 1fr)); gap: 16px; }
  figure.chart { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
  figure.chart figcaption { font-weight: 600; margin-bottom: 8px; }
  svg.chart { width: 100%; height: auto; display: block; }
  svg.chart .label { font-size: 12px; fill: #374151; }
  svg.chart .value { font-size: 12px; fill: #111827; font-variant-numeric: tabular-nums; }
  svg.chart .axis { font-size: 11px; fill: var(--muted); }
  svg.chart .bar, svg.chart .column { fill: #2563eb; }
  svg.chart .bar:hover, svg.chart .column:hover { fill: #1e40af; }
  svg.chart .baseline { stroke: #d1d5db; }
  svg.chart .total { font-size: 18px; font-weight: 700; fill: #111827; }
  .no-data { color: var(--muted); font-style: italic; margin: 24px 0; }
  .donut { display: flex; align-items: center; gap: 24px; }
  .donut svg.chart { width: 160px; flex: none; }
  .legend { list-style: none; margin: 0; padding: 0; }
  .legend li { margin: 4px 0; }
  .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; }
</style>
