#!/bin/bash -e
# Starts the app in production: prepares the database, seeds it the first time only, then runs Puma.
#
# Needs DATABASE_URL and SECRET_KEY_BASE. HR_EMAIL/HR_PASSWORD create (or reset) the HR login and
# ADMIN_EMAIL/ADMIN_PASSWORD the administrator's login for /admin.
cd "$(dirname "$0")/.."

bin/rails db:prepare

if bin/rails runner 'exit(Employee.exists? ? 0 : 1)'; then
  echo "Database already has employees; not seeding."
  bin/rails runner 'Seeding::Logins.ensure_from_env!.each { |message| puts message }'
else
  echo "Empty database: seeding the demo data."
  bin/rails db:seed
fi

exec bundle exec puma -C config/puma.rb
